.col-md-3
.col-md-6
  =simple_form_for(@draft_project_phase) do |f|
    =f.input :name
    =f.input :cost
    =f.input :cost_justification
    =f.input :count
    =f.input :cost_estimated, as: :hidden, input_html: { value: false }
    =f.input :fy_year, collection:  get_fiscal_years(start_of_fiscal_year(@draft_project_phase.scenario.fy_year), @draft_project_phase.scenario.ending_fy_year - @draft_project_phase.scenario.fy_year), label: 'Fy Year', include_blank: false
    =f.association :team_ali_code, :collection => @draft_project_phase.draft_project.team_ali_code.children, :label_method => 'full_name', :label => 'ALI Code', include_blank: false
    //=f.input :justification
    =f.submit 'Save', class: 'btn btn-primary'